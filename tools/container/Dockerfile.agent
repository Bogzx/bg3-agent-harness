# The play clients for `play.py run --sandbox container` (README.md, "The runner"): the claude, codex and gemini CLIs
# and nothing of the repo, the game, the saves or the memory. The runner starts it on the internal sandbox network
# with only the bg3 MCP server (http://172.30.99.1:8770/mcp) configured and the egress proxy (172.30.99.2:3128) as
# its way to the model API. Versions are pinned to what the host runs (build args; runner/sandbox.py passes them).
FROM node:22-bookworm-slim

ARG CLAUDE_VERSION=2.1.301
ARG CODEX_VERSION=0.157.1
ARG GEMINI_VERSION=0.64.0
RUN npm install -g --no-fund --no-audit "@anthropic-ai/claude-code@${CLAUDE_VERSION}" \
        "@openai/codex@${CODEX_VERSION}" "@google/gemini-cli@${GEMINI_VERSION}" \
    && npm cache clean --force
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates tini && rm -rf /var/lib/apt/lists/*

# The runner runs it as the host user (--user uid:gid) with HOME=/home/agent mounted from
# runtime/sessions/<playthrough>/sandbox-home: the CLIs' own state (sessions to resume, settings) and nothing else.
RUN mkdir -p /home/agent && chmod 1777 /home/agent
ENV HOME=/home/agent
WORKDIR /home/agent
ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["claude", "--version"]
