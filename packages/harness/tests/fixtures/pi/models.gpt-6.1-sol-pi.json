{
 "providers": {
  "openai-codex": {
   "baseUrl": "https://chatgpt.com/backend-api",
   "api": "openai-codex-responses",
   "apiKey": "${BG3AI_CODEX_ACCESS_TOKEN}",
   "models": [
    {
     "id": "gpt-6.1-sol",
     "name": "gpt-6.1-sol",
     "api": "openai-codex-responses",
     "reasoning": true,
     "input": [
      "text",
      "image"
     ],
     "contextWindow": 500000,
     "maxTokens": 128000,
     "cost": {
      "input": 2.0,
      "output": 10.0,
      "cacheRead": 0.1,
      "cacheWrite": 2.5,
      "tiers": [
       {
        "inputTokensAbove": 272000,
        "input": 4.0,
        "output": 15.0,
        "cacheRead": 0.2,
        "cacheWrite": 5.0
       }
      ]
     },
     "thinkingLevelMap": {
      "off": null,
      "minimal": "low"
     },
     "compat": {
      "supportsOpenAIGrammarTools": true,
      "supportsAdditionalTools": true,
      "supportsToolSearch": true,
      "supportsMidConvoSystemMessages": true
     }
    }
   ]
  }
 }
}
