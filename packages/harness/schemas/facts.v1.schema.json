{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Bogzx/bg3-agent-harness/packages/harness/schemas/facts.v1.schema.json",
  "title": "facts.jsonl v1: one record per line",
  "description": "What the game state was, written by the harness per run (never seen by the agent). The benchmark's graders read it; the harness does not decide what counts as winning. Time zero of a run is the first run_start mark. `t` is wall-clock epoch seconds; `game_t` is game seconds since run_start with paused time (menu think-pause) excluded, or null when the harness cannot measure it; grading on game time (decision D7) needs it on every record from the run_start mark on. Records are in non-decreasing `t` order.",
  "type": "object",
  "required": ["v", "kind", "t"],
  "properties": {
    "v": {"const": 1},
    "kind": {"enum": ["snapshot", "event", "mark"]},
    "t": {"type": "number"},
    "game_t": {"type": ["number", "null"], "minimum": 0}
  },
  "allOf": [
    {"if": {"properties": {"kind": {"const": "snapshot"}}}, "then": {"$ref": "#/$defs/snapshot"}},
    {"if": {"properties": {"kind": {"const": "event"}}}, "then": {"$ref": "#/$defs/event"}},
    {"if": {"properties": {"kind": {"const": "mark"}}}, "then": {"$ref": "#/$defs/mark"}}
  ],
  "$defs": {
    "name": {"type": "string", "minLength": 1},
    "count": {"type": "integer", "minimum": 0},
    "member": {
      "type": "object",
      "required": ["name", "level", "dead", "downed"],
      "properties": {
        "name": {"$ref": "#/$defs/name"},
        "level": {"type": "integer", "minimum": 0},
        "hp": {"type": "number"},
        "max_hp": {"type": "number"},
        "dead": {"type": "boolean"},
        "downed": {"type": "boolean"},
        "avatar": {"type": "boolean", "description": "the player's own character"},
        "summon": {"type": "boolean", "description": "a summon or other temporary member; not counted as party"}
      }
    },
    "item": {
      "type": "object",
      "required": ["name", "count"],
      "properties": {
        "name": {"$ref": "#/$defs/name"},
        "tpl": {"type": "string", "description": "root template id"},
        "count": {"$ref": "#/$defs/count"},
        "owner": {"type": "string"}
      }
    },
    "snapshot": {
      "description": "The full state at one instant: replaces everything the previous snapshot said.",
      "type": "object",
      "required": ["gold", "party", "region", "areas", "combat", "inv", "quests"],
      "properties": {
        "gold": {"$ref": "#/$defs/count"},
        "party": {"type": "array", "items": {"$ref": "#/$defs/member"}},
        "region": {"type": ["string", "null"]},
        "area": {"type": ["string", "null"], "description": "current minimap area"},
        "areas": {"type": "array", "items": {"type": "string"}, "description": "every area discovered so far"},
        "combat": {"type": "boolean"},
        "inv": {"type": "array", "items": {"$ref": "#/$defs/item"}, "description": "party inventories"},
        "quests": {"type": "object", "additionalProperties": {"type": "boolean"}, "description": "journal title -> done"}
      }
    },
    "event": {
      "type": "object",
      "required": ["ev"],
      "properties": {
        "ev": {"enum": [
          "combat_started", "combat_ended", "died", "downed", "revived", "level_up", "joined",
          "gold", "item_added", "trade_open", "trade_end", "pickpocket", "stole", "crime", "kill", "loot",
          "quest_added", "quest_done", "region", "area", "level_changed", "game_end"
        ]}
      },
      "allOf": [
        {"if": {"properties": {"ev": {"enum": ["died", "downed", "revived"]}}},
         "then": {"required": ["name", "party"], "properties": {"name": {"$ref": "#/$defs/name"}, "party": {"type": "boolean"}}}},
        {"if": {"properties": {"ev": {"const": "level_up"}}},
         "then": {"required": ["name", "level"], "properties": {"name": {"$ref": "#/$defs/name"}, "level": {"type": "integer", "minimum": 1}}}},
        {"if": {"properties": {"ev": {"const": "joined"}}},
         "then": {"required": ["name"], "properties": {"name": {"$ref": "#/$defs/name"}}}},
        {"if": {"properties": {"ev": {"const": "gold"}}},
         "then": {"required": ["gold", "delta"], "properties": {"gold": {"$ref": "#/$defs/count"}, "delta": {"type": "integer"}}}},
        {"if": {"properties": {"ev": {"const": "item_added"}}},
         "then": {"required": ["name", "count"], "properties": {"name": {"$ref": "#/$defs/name"}, "count": {"type": "integer", "minimum": 1}, "tpl": {"type": "string"}, "gold": {"type": "boolean"}}}},
        {"if": {"properties": {"ev": {"enum": ["trade_open", "trade_end"]}}},
         "then": {"properties": {"npc": {"type": "string"}}}},
        {"if": {"properties": {"ev": {"const": "pickpocket"}}},
         "then": {"required": ["ok"], "properties": {"ok": {"type": "boolean"}, "npc": {"type": "string"}, "item": {"type": "string"}, "count": {"$ref": "#/$defs/count"}}}},
        {"if": {"properties": {"ev": {"const": "stole"}}},
         "then": {"properties": {"char": {"type": "string"}, "item": {"type": "string"}, "tpl": {"type": "string"}}}},
        {"if": {"properties": {"ev": {"const": "crime"}}},
         "then": {"required": ["type"], "properties": {"type": {"type": "string"}, "victim": {"type": "string"}, "criminal": {"type": "string"}}}},
        {"if": {"properties": {"ev": {"const": "kill"}}},
         "then": {"required": ["victim"], "properties": {"victim": {"$ref": "#/$defs/name"}, "killer": {"type": "string"}, "trader": {"type": "boolean"}}}},
        {"if": {"properties": {"ev": {"const": "loot"}}},
         "then": {"properties": {"from": {"enum": ["corpse", "container"]}, "item": {"type": "string"}}}},
        {"if": {"properties": {"ev": {"enum": ["quest_added", "quest_done"]}}},
         "then": {"required": ["title"], "properties": {"title": {"$ref": "#/$defs/name"}}}},
        {"if": {"properties": {"ev": {"enum": ["region", "area", "level_changed"]}}},
         "then": {"required": ["name"], "properties": {"name": {"$ref": "#/$defs/name"}}}}
      ]
    },
    "mark": {
      "type": "object",
      "required": ["mark"],
      "properties": {
        "mark": {"enum": ["load", "run_start", "run_end"]},
        "detail": {}
      }
    }
  }
}
