{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Bogzx/bg3-agent-harness/packages/harness/schemas/facts.v1.schema.json",
  "title": "facts.jsonl v1: one record per line",
  "description": "What the game state was, written by the harness per run (never seen by the agent). The benchmark's graders read it; the harness does not decide what counts as winning. Time zero of a run is the first run_start mark. `t` is wall-clock epoch seconds; `game_t` is game seconds since run_start with paused time (menu think-pause) excluded, or null when the harness cannot measure it; grading on game time (decision D7) needs it on every record from the run_start mark on. Records are in non-decreasing `t` order: a record with its own earlier time (a referee ring record, a dialogue choice) is written at the last record's `t` and keeps its own in `at`. Compatible extensions (2026-10-21, still v1: readers skip what they don't know): the `choice` event and the `settings` mark; 2026-10-29: the `game_over` event (the game's Game Over screen came up: the party wiped by the game's own rule); the `pos` event, the snapshot's `leader` and each member's `pos` (positions, [x, y, z] m, y up); 2026-11-01: a two-team match's `arena_start`, `arena_turn`, `arena_turn_forced`, `arena_end` and `arena_reaction_unowned` events (bg3harness.arena).",
  "type": "object",
  "required": ["v", "kind", "t"],
  "properties": {
    "v": {"const": 1},
    "kind": {"enum": ["snapshot", "event", "mark"]},
    "t": {"type": "number"},
    "game_t": {"type": ["number", "null"], "minimum": 0},
    "at": {"type": "number", "description": "when it happened (epoch s), if earlier than `t`"}
  },
  "allOf": [
    {"if": {"properties": {"kind": {"const": "snapshot"}}}, "then": {"$ref": "#/$defs/snapshot"}},
    {"if": {"properties": {"kind": {"const": "event"}}}, "then": {"$ref": "#/$defs/event"}},
    {"if": {"properties": {"kind": {"const": "mark"}}}, "then": {"$ref": "#/$defs/mark"}}
  ],
  "$defs": {
    "name": {"type": "string", "minLength": 1},
    "count": {"type": "integer", "minimum": 0},
    "pos": {"type": "array", "items": {"type": "number"}, "minItems": 3, "maxItems": 3, "description": "[x, y, z] in metres, y up (added 2026-10-29)"},
    "member": {
      "type": "object",
      "required": ["name", "level", "dead", "downed"],
      "properties": {
        "name": {"$ref": "#/$defs/name"},
        "level": {"type": "integer", "minimum": 0},
        "hp": {"type": "number"},
        "max_hp": {"type": "number"},
        "dead": {"type": "boolean"},
        "downed": {"type": "boolean"},
        "avatar": {"type": "boolean", "description": "the player's own character"},
        "summon": {"type": "boolean", "description": "a summon or other temporary member; not counted as party"},
        "pos": {"$ref": "#/$defs/pos"}
      }
    },
    "item": {
      "type": "object",
      "required": ["name", "count"],
      "properties": {
        "name": {"$ref": "#/$defs/name"},
        "tpl": {"type": "string", "description": "root template id"},
        "count": {"$ref": "#/$defs/count"},
        "owner": {"type": "string"}
      }
    },
    "snapshot": {
      "description": "The full state at one instant: replaces everything the previous snapshot said.",
      "type": "object",
      "required": ["gold", "party", "region", "areas", "combat", "inv", "quests"],
      "properties": {
        "gold": {"$ref": "#/$defs/count"},
        "party": {"type": "array", "items": {"$ref": "#/$defs/member"}},
        "region": {"type": ["string", "null"]},
        "leader": {"type": ["string", "null"], "description": "the party member the player controls (added 2026-10-29)"},
        "area": {"type": ["string", "null"], "description": "current minimap area"},
        "areas": {"type": "array", "items": {"type": "string"}, "description": "every area discovered so far"},
        "combat": {"type": "boolean"},
        "inv": {"type": "array", "items": {"$ref": "#/$defs/item"}, "description": "party inventories"},
        "quests": {"type": "object", "additionalProperties": {"type": "boolean"}, "description": "journal title -> done"}
      }
    },
    "event": {
      "type": "object",
      "required": ["ev"],
      "properties": {
        "ev": {"enum": [
          "combat_started", "combat_ended", "died", "downed", "revived", "level_up", "joined",
          "gold", "item_added", "trade_open", "trade_end", "pickpocket", "stole", "crime", "kill", "loot",
          "quest_added", "quest_done", "region", "area", "level_changed", "game_end", "choice",
          "game_over", "pos", "approval", "arena_start", "arena_turn", "arena_turn_forced", "arena_end",
          "arena_reaction_unowned"
        ]}
      },
      "allOf": [
        {"if": {"properties": {"ev": {"enum": ["died", "downed", "revived"]}}},
         "then": {"required": ["name", "party"], "properties": {"name": {"$ref": "#/$defs/name"}, "party": {"type": "boolean"}}}},
        {"if": {"properties": {"ev": {"const": "level_up"}}},
         "then": {"required": ["name", "level"], "properties": {"name": {"$ref": "#/$defs/name"}, "level": {"type": "integer", "minimum": 1}}}},
        {"if": {"properties": {"ev": {"const": "joined"}}},
         "then": {"required": ["name"], "properties": {"name": {"$ref": "#/$defs/name"}}}},
        {"if": {"properties": {"ev": {"const": "gold"}}},
         "then": {"required": ["gold", "delta"], "properties": {"gold": {"$ref": "#/$defs/count"}, "delta": {"type": "integer"}}}},
        {"if": {"properties": {"ev": {"const": "item_added"}}},
         "then": {"required": ["name", "count"], "properties": {"name": {"$ref": "#/$defs/name"}, "count": {"type": "integer", "minimum": 1}, "tpl": {"type": "string"}, "gold": {"type": "boolean"}}}},
        {"if": {"properties": {"ev": {"enum": ["trade_open", "trade_end"]}}},
         "then": {"properties": {"npc": {"type": "string"}}}},
        {"if": {"properties": {"ev": {"const": "pickpocket"}}},
         "then": {"required": ["ok"], "properties": {"ok": {"type": "boolean"}, "npc": {"type": "string"}, "item": {"type": "string"}, "count": {"$ref": "#/$defs/count"},
                  "attempt": {"type": "integer", "minimum": 1, "description": "the pickpocket window (one RequestPickpocket) this record belongs to: one failure, or one record per item taken; absent when no window was open (added 2026-10-29)"}}}},
        {"if": {"properties": {"ev": {"const": "stole"}}},
         "then": {"properties": {"char": {"type": "string"}, "item": {"type": "string"}, "tpl": {"type": "string"}}}},
        {"if": {"properties": {"ev": {"const": "crime"}}},
         "then": {"required": ["type"], "properties": {"type": {"type": "string"}, "victim": {"type": "string"}, "criminal": {"type": "string"},
                  "victim_uuid": {"type": "string"},
                  "enemy": {"type": "boolean", "description": "the victim was the criminal's enemy when the crime was registered (added 2026-10-29): the game registers Murder for a fight's target too"},
                  "in_combat": {"type": "boolean", "description": "the criminal was in combat when the crime was registered (added 2026-10-29)"}}}},
        {"if": {"properties": {"ev": {"const": "kill"}}},
         "then": {"required": ["victim"], "properties": {"victim": {"$ref": "#/$defs/name"}, "killer": {"type": "string"}, "trader": {"type": "boolean"},
                  "by_party": {"type": "boolean", "description": "the killer is a party member (absent in progress-era records)"},
                  "summon": {"type": "boolean", "description": "the victim is a summon or conjured creature (added 2026-10-28, absent = false); summoner, summoner_uuid: whose, when known"},
                  "summoner": {"type": "string"}, "summoner_uuid": {"type": "string"},
                  "temporary": {"type": "boolean", "description": "the victim was spawned at run time (added 2026-10-28, absent = false)"}}}},
        {"if": {"properties": {"ev": {"const": "died"}}},
         "then": {"properties": {"summon": {"type": "boolean"}, "summoner": {"type": "string"}, "summoner_uuid": {"type": "string"}, "temporary": {"type": "boolean"}}}},
        {"if": {"properties": {"ev": {"const": "loot"}}},
         "then": {"properties": {"from": {"enum": ["corpse", "container"]}, "item": {"type": "string"}}}},
        {"if": {"properties": {"ev": {"enum": ["quest_added", "quest_done"]}}},
         "then": {"required": ["title"], "properties": {"title": {"$ref": "#/$defs/name"}}}},
        {"if": {"properties": {"ev": {"const": "choice"}}},
         "then": {"description": "a dialogue answer the agent picked (choose_dialogue), with what it was shown and the reason it stated",
                  "required": ["scene", "options", "picked"],
                  "properties": {"scene": {"type": "string", "description": "the DIALOGUE line shown: speaker: text"},
                                 "options": {"type": "array", "items": {"type": "object", "required": ["i", "text"], "properties": {"i": {"type": "integer"}, "text": {"type": "string"}}}},
                                 "picked": {"type": "integer"},
                                 "picked_text": {"type": "string"},
                                 "reason": {"type": "string", "description": "the agent's text and thinking since the tool result before the call"}}}},
        {"if": {"properties": {"ev": {"const": "approval"}}},
         "then": {"description": "a companion's approval rating changed (added 2026-10-29)",
                  "required": ["companion", "total"],
                  "properties": {"companion": {"$ref": "#/$defs/name"}, "companion_uuid": {"type": "string"},
                                 "toward": {"type": "string", "description": "whose rating it is (the rated character)"},
                                 "delta": {"type": ["integer", "null"], "description": "the change; absent when the rating before it was not known"},
                                 "total": {"type": "integer"}}}},
        {"if": {"properties": {"ev": {"const": "pos"}}},
         "then": {"description": "the leader's position on a read between snapshots, when it moved 1 m or more, another character leads or the region changed (added 2026-10-29)",
                  "required": ["name", "pos"], "properties": {"name": {"$ref": "#/$defs/name"}, "pos": {"$ref": "#/$defs/pos"}, "region": {"type": ["string", "null"]}}}},
        {"if": {"properties": {"ev": {"enum": ["region", "area", "level_changed"]}}},
         "then": {"required": ["name"], "properties": {"name": {"$ref": "#/$defs/name"}}}},
        {"if": {"properties": {"ev": {"const": "arena_start"}}},
         "then": {"description": "a two-team match began (bg3harness.arena; added 2026-11-01): the arena, its dice seed, each side's characters in the arena file's order, the player of each side (\"<client>/<model slug>\") and each side's character uuids",
                  "required": ["arena", "seed", "teams", "sides"],
                  "properties": {"arena": {"$ref": "#/$defs/name"}, "seed": {"type": "integer", "minimum": 0},
                                 "teams": {"$ref": "#/$defs/sides_names"}, "sides": {"$ref": "#/$defs/sides_name"},
                                 "uuids": {"$ref": "#/$defs/sides_names"}}}},
        {"if": {"properties": {"ev": {"const": "arena_turn"}}},
         "then": {"description": "a side's phase began in a match: one same-side run of the rolled order inside a turn group (the mod's phase check); character = its first open member, members = its open members in turn order, phase = its 1-based index in the group, group = the turn group's id, shared = the group holds both sides",
                  "required": ["side", "character", "members", "round", "phase", "group", "shared"],
                  "properties": {"side": {"enum": ["A", "B"]}, "character": {"$ref": "#/$defs/name"},
                                 "members": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/name"}},
                                 "round": {"type": "integer", "minimum": 1}, "phase": {"type": "integer", "minimum": 1},
                                 "group": {"type": "string"}, "shared": {"type": "boolean"}}}},
        {"if": {"properties": {"ev": {"const": "arena_turn_forced"}}},
         "then": {"description": "the harness ended the phase in progress at its model-time cap (act.end_turn for each of its members); side and character are the phase's",
                  "required": ["side", "character"],
                  "properties": {"side": {"enum": ["A", "B"]}, "character": {"$ref": "#/$defs/name"}}}},
        {"if": {"properties": {"ev": {"const": "arena_reaction_unowned"}}},
         "then": {"description": "the harness declined a reaction prompt no team owns (neither side's to answer): the round and the prompt's text",
                  "required": ["round", "detail"],
                  "properties": {"round": {"type": "integer", "minimum": 0}, "detail": {"type": "string"}}}},
        {"if": {"properties": {"ev": {"const": "arena_end"}}},
         "then": {"description": "the match ended: wipe (the mod's, at a turn boundary), forfeit (forfeit: the side, cause forced_turns or client_fault), round_cap and wall_cap (draws: winner null), abort, fault; the HP fractions are each side's summed current over summed max HP",
                  "required": ["winner", "reason", "rounds", "hp_left_A", "hp_left_B"],
                  "properties": {"winner": {"enum": ["A", "B", null]},
                                 "reason": {"enum": ["wipe", "forfeit", "round_cap", "wall_cap", "abort", "fault"]},
                                 "rounds": {"type": "integer", "minimum": 0},
                                 "hp_left_A": {"type": "number", "minimum": 0, "maximum": 1},
                                 "hp_left_B": {"type": "number", "minimum": 0, "maximum": 1},
                                 "forfeit": {"enum": ["A", "B"]}, "cause": {"enum": ["forced_turns", "client_fault"]},
                                 "detail": {"type": "string", "description": "the runner's own end, when the mod's end came before it"}},
                  "allOf": [{"if": {"properties": {"reason": {"const": "forfeit"}}}, "then": {"required": ["forfeit", "cause"]}},
                            {"if": {"properties": {"reason": {"enum": ["round_cap", "wall_cap"]}}}, "then": {"properties": {"winner": {"type": "null"}}}}]}}
      ]
    },
    "sides_names": {
      "type": "object", "required": ["A", "B"], "additionalProperties": false,
      "properties": {"A": {"type": "array", "items": {"$ref": "#/$defs/name"}}, "B": {"type": "array", "items": {"$ref": "#/$defs/name"}}}
    },
    "sides_name": {
      "type": "object", "required": ["A", "B"], "additionalProperties": false,
      "properties": {"A": {"$ref": "#/$defs/name"}, "B": {"$ref": "#/$defs/name"}}
    },
    "mark": {
      "type": "object",
      "required": ["mark"],
      "properties": {
        "mark": {"enum": ["load", "run_start", "run_end", "settings"], "description": "settings: detail = the game's settings readout and the seed setup (bg3harness/game_settings.py)"},
        "detail": {}
      }
    }
  }
}
