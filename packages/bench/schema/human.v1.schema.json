{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Bogzx/bg3-agent-harness/packages/bench/schema/human.v1.schema.json",
  "title": "Human baseline results v1",
  "description": "Every attempt one player made at the benchmark scenarios through the normal game, from each scenario's SCN start save (docs/HUMAN-BASELINE.md). Read by bg3bench.human, which also checks what a schema can't: known scenario names, attempts numbered 1..n per scenario, t_pass_s within time_s, picks only on choice scenarios.",
  "type": "object",
  "required": [
    "schema",
    "player",
    "attempts"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": 1
    },
    "player": {
      "type": "string",
      "pattern": "^[a-z0-9_-]+$",
      "description": "the leaderboard row is 'human (<player>)'"
    },
    "game_version": {
      "type": [
        "string",
        "null"
      ],
      "description": "the BG3 build the attempts were played on"
    },
    "attempts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "scenario",
          "attempt",
          "date",
          "passed",
          "time_s",
          "t_pass_s",
          "reloads",
          "void"
        ],
        "additionalProperties": false,
        "properties": {
          "scenario": {
            "type": "string",
            "minLength": 1
          },
          "attempt": {
            "type": "integer",
            "minimum": 1
          },
          "date": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "passed": {
            "type": "boolean",
            "description": "the goal was met, as the player saw it"
          },
          "time_s": {
            "type": "number",
            "minimum": 0,
            "description": "wall time from the save loaded to the attempt's end"
          },
          "t_pass_s": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "description": "wall time when the goal was met; null unless passed"
          },
          "reloads": {
            "type": "integer",
            "minimum": 0
          },
          "void": {
            "type": [
              "string",
              "null"
            ],
            "description": "why this was not a fair attempt (crash, wrong save); null: it counts"
          },
          "picks": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "scene",
                "pick"
              ],
              "additionalProperties": false,
              "properties": {
                "scene": {
                  "type": "string"
                },
                "pick": {
                  "type": "string"
                }
              }
            }
          },
          "notes": {
            "type": "string"
          }
        }
      }
    }
  }
}
