{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Bogzx/bg3-agent-harness/packages/bench/schema/results.v1.schema.json",
  "title": "Release results v1 (results.json)",
  "description": "Every run of a release and the statistics per (model, condition), from valid runs only. `stats` is bg3bench.stats.summarize output (null when a group has no valid run). Built by bg3bench.results.build_results.",
  "type": "object",
  "required": ["schema", "bench_tag", "created", "seed", "b", "runs", "groups"],
  "additionalProperties": false,
  "$defs": {
    "num_or_null": {"type": ["number", "null"], "minimum": 0},
    "str_or_null": {"type": ["string", "null"]},
    "suite": {"type": "string", "pattern": "^bench-v[0-9]+\\.[0-9]+$"}
  },
  "properties": {
    "schema": {"const": 1},
    "bench_tag": {"$ref": "#/$defs/str_or_null"},
    "suite": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/suite"}], "description": "the suite version (bench-vX.Y) of every run in the release; null: no runs"},
    "created": {"type": "number"},
    "seed": {"type": "integer"},
    "b": {"type": "integer", "minimum": 1},
    "runs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["run_id", "versions", "scenario", "model", "condition", "valid", "passed", "t_pass_s", "cost_usd", "wall_s", "think_s", "timing", "luck_z", "tokens"],
        "additionalProperties": false,
        "properties": {
          "run_id": {"type": "string", "minLength": 1},
          "versions": {
            "type": "object",
            "description": "the run manifest's versions: harness, bench and the suite (bench-vX.Y of bench)",
            "required": ["harness", "bench"],
            "additionalProperties": false,
            "properties": {"harness": {"$ref": "#/$defs/str_or_null"}, "bench": {"type": "string", "minLength": 1}, "suite": {"$ref": "#/$defs/suite"}}
          },
          "scenario": {"type": "string", "minLength": 1},
          "model": {"type": "string", "minLength": 1},
          "condition": {"$ref": "#/$defs/str_or_null"},
          "valid": {"type": "boolean"},
          "passed": {"type": ["boolean", "null"], "description": "null: a maximise scenario's run (no pass); added 2026-10-25"},
          "t_pass_s": {"$ref": "#/$defs/num_or_null"},
          "cost_usd": {"$ref": "#/$defs/num_or_null"},
          "wall_s": {"$ref": "#/$defs/num_or_null"},
          "think_s": {"$ref": "#/$defs/num_or_null"},
          "timing": {"enum": ["realtime", "turn_based", null]},
          "luck_z": {"type": ["number", "null"]},
          "tokens": {
            "type": "object",
            "required": ["input", "output", "cache_read", "cache_write"],
            "additionalProperties": false,
            "properties": {
              "input": {"type": "integer", "minimum": 0},
              "output": {"type": "integer", "minimum": 0},
              "cache_read": {"type": "integer", "minimum": 0},
              "cache_write": {"type": "integer", "minimum": 0}
            }
          },
          "score": {
            "description": "a maximise scenario's score (bg3bench.graders.measure): the fact's value at the run's first snapshot (start) and at run_end (end), gain = end - start (the score), its peak; null without a snapshot. Optional, added 2026-10-25 (still v1).",
            "type": "object",
            "required": ["fact", "start", "end", "gain", "peak"],
            "additionalProperties": false,
            "properties": {
              "fact": {"type": "string", "minLength": 1},
              "start": {"type": ["number", "null"]},
              "end": {"type": ["number", "null"]},
              "gain": {"type": ["number", "null"]},
              "peak": {"type": ["number", "null"]}
            }
          },
          "choices": {
            "description": "a choice scenario's picks (scene, picked text) and the persona fit score (null: not judged); optional, added 2026-10-22",
            "type": "object",
            "required": ["picks", "fit"],
            "additionalProperties": false,
            "properties": {
              "picks": {"type": "array", "items": {"type": "object", "required": ["scene", "pick"], "additionalProperties": false,
                        "properties": {"scene": {"type": "string"}, "pick": {"type": "string"}}}},
              "fit": {"type": ["number", "null"], "minimum": 0, "maximum": 10}
            }
          }
        }
      }
    },
    "groups": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["model", "condition", "n_runs", "n_invalid", "invalid_rate", "stats", "cost_usd", "wall_s", "think_s"],
        "additionalProperties": false,
        "properties": {
          "model": {"type": "string", "minLength": 1},
          "condition": {"$ref": "#/$defs/str_or_null"},
          "n_runs": {"type": "integer", "minimum": 1},
          "n_invalid": {"type": "integer", "minimum": 0},
          "invalid_rate": {"type": "number", "minimum": 0, "maximum": 1},
          "harness": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true, "description": "the harness versions the group's runs played with (sorted; unknown ones left out)"},
          "stats": {
            "oneOf": [
              {"type": "null"},
              {
                "type": "object",
                "required": ["schema", "seed", "b", "alpha", "per_scenario", "aggregate"],
                "properties": {
                  "schema": {"const": 1},
                  "per_scenario": {
                    "type": "object",
                    "additionalProperties": {
                      "type": "object",
                      "required": ["n", "k", "rate", "wilson", "pass_hat"],
                      "properties": {
                        "n": {"type": "integer", "minimum": 1},
                        "k": {"type": "integer", "minimum": 0},
                        "rate": {"type": "number", "minimum": 0, "maximum": 1},
                        "wilson": {"type": "array", "items": {"type": "number"}, "minItems": 2, "maxItems": 2},
                        "pass_hat": {"type": "object", "additionalProperties": {"type": "number"}}
                      }
                    }
                  },
                  "aggregate": {
                    "type": "object",
                    "required": ["mean_rate", "ci", "n_scenarios", "n_runs"],
                    "properties": {
                      "mean_rate": {"type": "number"},
                      "ci": {"type": "array", "items": {"type": "number"}, "minItems": 2, "maxItems": 2},
                      "n_scenarios": {"type": "integer", "minimum": 1},
                      "n_runs": {"type": "integer", "minimum": 1}
                    }
                  }
                }
              }
            ]
          },
          "cost_usd": {
            "type": "object",
            "required": ["median_per_run", "per_success"],
            "additionalProperties": false,
            "properties": {
              "median_per_run": {"$ref": "#/$defs/num_or_null"},
              "per_success": {"$ref": "#/$defs/num_or_null"}
            }
          },
          "wall_s": {
            "type": "object",
            "required": ["median"],
            "additionalProperties": false,
            "properties": {"median": {"$ref": "#/$defs/num_or_null"}}
          },
          "think_s": {
            "type": "object",
            "required": ["median"],
            "additionalProperties": false,
            "properties": {"median": {"$ref": "#/$defs/num_or_null"}}
          },
          "suite_score": {"type": ["number", "null"], "minimum": 0, "maximum": 1, "description": "the mean pass rate over the condition's common set (ranking.scenarios; an unranked model: over its own cells of it); null: none of them. Optional, added 2026-10-29"},
          "suite_n": {"type": "integer", "minimum": 0, "description": "the scenarios suite_score is over"},
          "rank_range": {"oneOf": [{"type": "null"}, {"type": "array", "items": {"type": "integer", "minimum": 1}, "minItems": 2, "maxItems": 2}], "description": "[lo, hi]: the rank (1 = best) the scenario bootstrap gives the model in 95% of its draws (stats.rank_ranges); null: not ranked"},
          "ranked": {"type": "boolean", "description": "valid runs in at least ranking.min_cells of the condition's scenarios, and a common set to rank on"}
        }
      }
    },
    "ranking": {
      "type": "array",
      "description": "per condition, what its models are ranked on (bg3bench.results._rank). Optional, added 2026-10-29",
      "items": {
        "type": "object",
        "required": ["condition", "scenarios", "of", "min_cells", "models"],
        "additionalProperties": false,
        "properties": {
          "condition": {"$ref": "#/$defs/str_or_null"},
          "scenarios": {"type": "array", "items": {"type": "string", "minLength": 1}, "description": "the common set: pass/fail scenarios (no choice, no maximise) every ranked model has a valid run of"},
          "of": {"type": "integer", "minimum": 0, "description": "the condition's scenarios (any run)"},
          "min_cells": {"type": "integer", "minimum": 0, "description": "the scenarios with a valid run a model needs to be ranked (results.RANKED_SHARE of `of`)"},
          "models": {"type": "array", "items": {"type": "string", "minLength": 1}, "description": "the ranked models by suite_score (best first), then the unranked"}
        }
      }
    }
  }
}
