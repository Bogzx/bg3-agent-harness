{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Bogzx/bg3-agent-harness/packages/bench/schema/arena-facts.v1.schema.json",
  "title": "The arena referee's facts.jsonl events, a facts v1 extension",
  "description": "The events the harness writes from the referee (harness-only, never seen by either agent) into a match's one facts.jsonl, next to the facts v1 records (packages/harness/schemas/facts.v1.schema.json: v, kind, t, game_t, at). bg3bench.arena.grade reads them. Sides are A and B; a player is the model a side's client plays (\"<client>/<model slug>\", as the pairing planner names it).",
  "type": "object",
  "required": [
    "v",
    "kind",
    "t",
    "ev"
  ],
  "$defs": {
    "side": {
      "enum": [
        "A",
        "B"
      ]
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "fraction": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    }
  },
  "properties": {
    "v": {
      "const": 1
    },
    "kind": {
      "const": "event"
    },
    "t": {
      "type": "number"
    },
    "game_t": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "at": {
      "type": "number"
    },
    "ev": {
      "enum": [
        "arena_start",
        "arena_turn",
        "arena_turn_forced",
        "arena_end",
        "arena_reaction_unowned"
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "ev": {
            "const": "arena_start"
          }
        }
      },
      "then": {
        "description": "The match began: once, after the arena setup and before the first turn.",
        "required": [
          "arena",
          "seed",
          "teams",
          "sides"
        ],
        "properties": {
          "arena": {
            "type": "string",
            "minLength": 1,
            "description": "the arena file's name"
          },
          "seed": {
            "type": "integer",
            "minimum": 0,
            "description": "the dice seed the mod applied"
          },
          "teams": {
            "type": "object",
            "required": [
              "A",
              "B"
            ],
            "additionalProperties": false,
            "properties": {
              "A": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/name"
                }
              },
              "B": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/name"
                }
              }
            },
            "description": "each side's characters, in the arena file's order"
          },
          "sides": {
            "type": "object",
            "required": [
              "A",
              "B"
            ],
            "additionalProperties": false,
            "properties": {
              "A": {
                "$ref": "#/$defs/name"
              },
              "B": {
                "$ref": "#/$defs/name"
              }
            },
            "description": "the player of each side"
          },
          "uuids": {
            "type": "object",
            "required": [
              "A",
              "B"
            ],
            "additionalProperties": false,
            "properties": {
              "A": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/name"
                }
              },
              "B": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/name"
                }
              }
            },
            "description": "each side's character uuids (arena.status teams): the luck covariate attributes rolls.jsonl rows by their roller"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "ev": {
            "const": "arena_turn"
          }
        }
      },
      "then": {
        "description": "A character's turn began (the game's TurnStarted).",
        "required": [
          "side",
          "character",
          "round"
        ],
        "properties": {
          "side": {
            "$ref": "#/$defs/side"
          },
          "character": {
            "$ref": "#/$defs/name"
          },
          "round": {
            "type": "integer",
            "minimum": 1,
            "description": "the combat round (CombatRoundStarted)"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "ev": {
            "const": "arena_turn_forced"
          }
        }
      },
      "then": {
        "description": "The harness ended the turn in progress at the per-turn model-time cap (act.end_turn); it names that turn's side and character.",
        "required": [
          "side",
          "character"
        ],
        "properties": {
          "side": {
            "$ref": "#/$defs/side"
          },
          "character": {
            "$ref": "#/$defs/name"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "ev": {
            "const": "arena_end"
          }
        }
      },
      "then": {
        "description": "The match ended: once, at a turn boundary. wipe: every character of the loser is down or dead; forfeit: the side in `forfeit` lost (cause forced_turns: three of its turns in a row forced to an end; client_fault: its client failed again after one resume); round_cap, wall_cap: a draw (winner null, HP recorded, never a tiebreak); abort: the harness ended it; fault: the game crashed or hung (both invalid).",
        "required": [
          "winner",
          "rounds",
          "hp_left_A",
          "hp_left_B",
          "reason"
        ],
        "properties": {
          "winner": {
            "oneOf": [
              {
                "$ref": "#/$defs/side"
              },
              {
                "type": "null"
              }
            ]
          },
          "rounds": {
            "type": "integer",
            "minimum": 0,
            "description": "rounds begun"
          },
          "hp_left_A": {
            "$ref": "#/$defs/fraction",
            "description": "side A's summed current HP over its summed max HP"
          },
          "hp_left_B": {
            "$ref": "#/$defs/fraction",
            "description": "side B's summed current HP over its summed max HP"
          },
          "reason": {
            "enum": [
              "wipe",
              "forfeit",
              "round_cap",
              "wall_cap",
              "abort",
              "fault"
            ]
          },
          "forfeit": {
            "$ref": "#/$defs/side",
            "description": "the side that forfeited (reason forfeit)"
          },
          "cause": {
            "enum": [
              "forced_turns",
              "client_fault"
            ],
            "description": "why it forfeited (reason forfeit)"
          },
          "detail": {
            "type": "string",
            "description": "the runner's own end, when the mod's end came before it"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "reason": {
                  "const": "forfeit"
                }
              }
            },
            "then": {
              "required": [
                "forfeit",
                "cause"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "reason": {
                  "enum": [
                    "round_cap",
                    "wall_cap"
                  ]
                }
              }
            },
            "then": {
              "properties": {
                "winner": {
                  "type": "null"
                }
              }
            }
          }
        ]
      }
    },
    {
      "if": {
        "properties": {
          "ev": {
            "const": "arena_reaction_unowned"
          }
        }
      },
      "then": {
        "description": "The harness declined a reaction prompt no team owns (neither side's to answer).",
        "required": [
          "round",
          "detail"
        ],
        "properties": {
          "round": {
            "type": "integer",
            "minimum": 0,
            "description": "the round it came up in"
          },
          "detail": {
            "type": "string",
            "description": "the prompt's text"
          }
        }
      }
    }
  ]
}
