{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Bogzx/bg3-agent-harness/packages/bench/schema/arena-facts.v1.schema.json",
  "title": "The arena referee's facts.jsonl events, a facts v1 extension",
  "description": "The events the harness writes from the referee (harness-only, never seen by either agent) into a match's one facts.jsonl, next to the facts v1 records (packages/harness/schemas/facts.v1.schema.json: v, kind, t, game_t, at). bg3bench.arena.grade reads them. Sides are A and B; a player is the model a side's client plays (\"<client>/<model slug>\", as the pairing planner names it).",
  "type": "object",
  "required": [
    "v",
    "kind",
    "t",
    "ev"
  ],
  "$defs": {
    "side": {
      "enum": [
        "A",
        "B"
      ]
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "fraction": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    }
  },
  "properties": {
    "v": {
      "const": 1
    },
    "kind": {
      "const": "event"
    },
    "t": {
      "type": "number"
    },
    "game_t": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "at": {
      "type": "number"
    },
    "ev": {
      "enum": [
        "arena_start",
        "arena_turn",
        "arena_turn_forced",
        "arena_end",
        "arena_reaction_unowned",
        "arena_turn_passed",
        "arena_stall"
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "ev": {
            "const": "arena_start"
          }
        }
      },
      "then": {
        "description": "The match began: once, after the arena setup and before the first turn.",
        "required": [
          "arena",
          "seed",
          "teams",
          "sides"
        ],
        "properties": {
          "arena": {
            "type": "string",
            "minLength": 1,
            "description": "the arena file's name"
          },
          "seed": {
            "type": "integer",
            "minimum": 0,
            "description": "the dice seed the mod applied"
          },
          "teams": {
            "type": "object",
            "required": [
              "A",
              "B"
            ],
            "additionalProperties": false,
            "properties": {
              "A": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/name"
                }
              },
              "B": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/name"
                }
              }
            },
            "description": "each side's characters, in the arena file's order"
          },
          "sides": {
            "type": "object",
            "required": [
              "A",
              "B"
            ],
            "additionalProperties": false,
            "properties": {
              "A": {
                "$ref": "#/$defs/name"
              },
              "B": {
                "$ref": "#/$defs/name"
              }
            },
            "description": "the player of each side"
          },
          "uuids": {
            "type": "object",
            "required": [
              "A",
              "B"
            ],
            "additionalProperties": false,
            "properties": {
              "A": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/name"
                }
              },
              "B": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/name"
                }
              }
            },
            "description": "each side's character uuids (arena.status teams): the luck covariate attributes rolls.jsonl rows by their roller"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "ev": {
            "const": "arena_turn"
          }
        }
      },
      "then": {
        "description": "A side's phase began: one same-side run of the rolled order inside a turn group (the game puts adjacent player characters of both teams into one shared group; the mod serialises it). A phase is the match's turn, a summon's too.",
        "required": [
          "side",
          "character",
          "members",
          "names",
          "round",
          "phase",
          "shared"
        ],
        "properties": {
          "side": {
            "$ref": "#/$defs/side"
          },
          "character": {
            "$ref": "#/$defs/name",
            "description": "the phase's first open member (members[0])"
          },
          "members": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/$defs/name"
            },
            "description": "the side's open members of the group at the phase's start, in turn order, summons included: a team member's name as in arena_start, a summon's display name"
          },
          "names": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            },
            "description": "the members' display names as the game gave them"
          },
          "round": {
            "type": "integer",
            "minimum": 1,
            "description": "the combat round (CombatRoundStarted)"
          },
          "phase": {
            "type": "integer",
            "minimum": 1,
            "description": "the phase's 1-based index within its turn group"
          },
          "group": {
            "type": "string",
            "description": "the turn group's id (its team guid, else its first member's uuid); absent when the mod can't read the turn order"
          },
          "shared": {
            "type": "boolean",
            "description": "the group holds members of both sides"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "ev": {
            "const": "arena_turn_forced"
          }
        }
      },
      "then": {
        "description": "The harness ended the phase in progress at its model-time cap (turn_cap_s times its member count) or at a held stall (arena_stall stall held), with act.end_turn for each member; it names that phase's side and character.",
        "required": [
          "side",
          "character"
        ],
        "properties": {
          "side": {
            "$ref": "#/$defs/side"
          },
          "character": {
            "$ref": "#/$defs/name"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "ev": {
            "const": "arena_end"
          }
        }
      },
      "then": {
        "description": "The match ended: once, at a turn boundary. wipe: every character of the loser is down or dead; forfeit: the side in `forfeit` lost (cause forced_turns: three of its turns in a row forced to an end; client_fault: its client failed again after one resume); round_cap, wall_cap: a draw (winner null, HP recorded, never a tiebreak); abort: the harness ended it; fault: the game crashed or hung; over_budget: both sides' cost reached the match's max_cost (all three invalid, winner null).",
        "required": [
          "winner",
          "rounds",
          "hp_left_A",
          "hp_left_B",
          "reason"
        ],
        "properties": {
          "winner": {
            "oneOf": [
              {
                "$ref": "#/$defs/side"
              },
              {
                "type": "null"
              }
            ]
          },
          "rounds": {
            "type": "integer",
            "minimum": 0,
            "description": "rounds begun"
          },
          "hp_left_A": {
            "$ref": "#/$defs/fraction",
            "description": "side A's summed current HP over its summed max HP"
          },
          "hp_left_B": {
            "$ref": "#/$defs/fraction",
            "description": "side B's summed current HP over its summed max HP"
          },
          "reason": {
            "enum": [
              "wipe",
              "forfeit",
              "round_cap",
              "wall_cap",
              "abort",
              "fault",
              "over_budget"
            ]
          },
          "forfeit": {
            "$ref": "#/$defs/side",
            "description": "the side that forfeited (reason forfeit)"
          },
          "cause": {
            "enum": [
              "forced_turns",
              "client_fault"
            ],
            "description": "why it forfeited (reason forfeit)"
          },
          "detail": {
            "type": "string",
            "description": "the runner's own end, when the mod's end came before it"
          },
          "invalid": {
            "const": "scripted",
            "description": "a side was the harness's scripted no-model client: a live check, never graded"
          },
          "cost": {
            "type": "object",
            "required": [
              "A",
              "B"
            ],
            "description": "each side's cost so far at the end, USD (the charged totals are arena.json's)",
            "properties": {
              "A": {
                "type": "number",
                "minimum": 0
              },
              "B": {
                "type": "number",
                "minimum": 0
              }
            }
          },
          "max_cost": {
            "type": [
              "number",
              "null"
            ],
            "exclusiveMinimum": 0,
            "description": "the match's money cap, both sides together (the match ends over_budget at it); null without one"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "reason": {
                  "const": "forfeit"
                }
              }
            },
            "then": {
              "required": [
                "forfeit",
                "cause"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "reason": {
                  "enum": [
                    "round_cap",
                    "wall_cap"
                  ]
                }
              }
            },
            "then": {
              "properties": {
                "winner": {
                  "type": "null"
                }
              }
            }
          }
        ]
      }
    },
    {
      "if": {
        "properties": {
          "ev": {
            "const": "arena_reaction_unowned"
          }
        }
      },
      "then": {
        "description": "The harness declined a reaction prompt no team owns (neither side's to answer).",
        "required": [
          "round",
          "detail"
        ],
        "properties": {
          "round": {
            "type": "integer",
            "minimum": 0,
            "description": "the round it came up in"
          },
          "detail": {
            "type": "string",
            "description": "the prompt's text"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "ev": {
            "const": "arena_turn_passed"
          }
        }
      },
      "then": {
        "description": "The mod ended the turn of a phase's member who can't act (why: downed or dead) so the next phase starts; character is named as in arena_turn, name is the display name, error is set when the game's EndTurn failed. Not a turn: results ignore it.",
        "required": [
          "side",
          "character",
          "why",
          "round"
        ],
        "properties": {
          "side": {
            "$ref": "#/$defs/side"
          },
          "character": {
            "$ref": "#/$defs/name"
          },
          "name": {
            "type": "string"
          },
          "why": {
            "enum": [
              "downed",
              "dead"
            ]
          },
          "round": {
            "type": "integer",
            "minimum": 0
          },
          "error": {
            "type": "string"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "ev": {
            "const": "arena_stall"
          }
        }
      },
      "then": {
        "description": "A phase (or the match before its first one: no side, character or members, round 0) made no progress for its stall time (idle_s: wall time less model time). stall held: its side still held a member, and the phase is capped (an arena_turn_forced follows, counted toward the forfeit). stall game: the game held the turn, and the match ends as a fault. status is the last arena.status, last each side's last tool calls. Results ignore it.",
        "required": [
          "stall",
          "round",
          "idle_s",
          "status",
          "last"
        ],
        "properties": {
          "stall": {
            "enum": [
              "held",
              "game"
            ]
          },
          "side": {
            "$ref": "#/$defs/side"
          },
          "character": {
            "$ref": "#/$defs/name"
          },
          "members": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/name"
            },
            "minItems": 1
          },
          "round": {
            "type": "integer",
            "minimum": 0
          },
          "idle_s": {
            "type": "number",
            "minimum": 0
          },
          "status": {
            "type": "object"
          },
          "last": {
            "type": "object"
          },
          "detail": {
            "type": "string"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "stall": {
                  "const": "held"
                }
              }
            },
            "then": {
              "required": [
                "side",
                "character",
                "members"
              ]
            }
          }
        ]
      }
    }
  ]
}
