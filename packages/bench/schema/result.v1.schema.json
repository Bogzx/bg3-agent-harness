{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Bogzx/bg3-agent-harness/packages/bench/schema/result.v1.schema.json",
  "title": "Run result v1 (result.json)",
  "description": "How one run ended, written after it. An invalid run (harness failure, operator action, runner error) is rerun and never scored. `grade` is the grader output over facts.jsonl, null for older series graded by the runner's milestone; `methods` is the sandbox method attribution (reported, never graded). Built by bg3bench.results.",
  "type": "object",
  "required": ["schema", "run_id", "outcome", "valid", "invalid_reason", "passed", "t_pass_s", "grade", "methods",
               "cost_usd", "tokens", "wall_s", "play_s", "think_s", "luck", "reloads", "deaths", "fairness"],
  "additionalProperties": false,
  "$defs": {
    "count": {"type": "integer", "minimum": 0},
    "num_or_null": {"type": ["number", "null"], "minimum": 0}
  },
  "properties": {
    "schema": {"const": 1},
    "run_id": {"type": "string", "minLength": 1},
    "outcome": {"enum": ["reached", "failed", "timeout", "over_budget", "gave_up", "runner_error"], "description": "failed (added 2026-10-22, still v1): a run its live verdict ended on a fired never or (2026-10-25) a party wipe"},
    "valid": {"type": "boolean"},
    "invalid_reason": {"enum": [null, "runner_error", "foreign_save", "harness_failure", "operator", "off_route", "unseeded"], "description": "foreign_save (added 2026-10-25, still v1): the run's game loaded a save that is not its start save or its own"},
    "passed": {"type": ["boolean", "null"], "description": "null: a maximise scenario's run, which has no pass (its score is score.gain); added 2026-10-25 (still v1)"},
    "t_pass_s": {"$ref": "#/$defs/num_or_null"},
    "grade": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "required": ["violations", "curve", "progress"],
          "additionalProperties": false,
          "properties": {
            "violations": {
              "type": "array",
              "items": {"type": "object", "required": ["t_s", "node"], "properties": {"t_s": {"type": "number"}}}
            },
            "curve": {
              "type": "object",
              "required": ["fact", "points"],
              "properties": {
                "fact": {"type": "string"},
                "points": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": ["at_s", "value", "peak"],
                    "properties": {
                      "at_s": {"type": "number"},
                      "value": {"type": ["number", "null"]},
                      "peak": {"type": ["number", "null"]}
                    }
                  }
                }
              }
            },
            "progress": {"type": ["number", "null"], "minimum": 0, "maximum": 1}
          }
        }
      ]
    },
    "methods": {"type": ["object", "null"]},
    "cost_usd": {"$ref": "#/$defs/num_or_null"},
    "tokens": {
      "type": "object",
      "required": ["input", "output", "cache_read", "cache_write"],
      "additionalProperties": false,
      "properties": {
        "input": {"$ref": "#/$defs/count"},
        "output": {"$ref": "#/$defs/count"},
        "cache_read": {"$ref": "#/$defs/count"},
        "cache_write": {"$ref": "#/$defs/count"}
      }
    },
    "wall_s": {"$ref": "#/$defs/num_or_null"},
    "play_s": {"$ref": "#/$defs/num_or_null"},
    "first_stop_s": {"$ref": "#/$defs/num_or_null", "description": "wall seconds from the run's start to the agent's first end of its turn (a stop resume or the run's end), null if it never ended its turn or the record is older; optional, added 2026-10-25 (still v1)"},
    "think_s": {"$ref": "#/$defs/num_or_null", "description": "the model's own time (model_time.model_s); realtime scenarios report it next to wall_s (D7)"},
    "luck": {
      "description": "bg3bench.luck.summary over the run's roll log (D9); null: no roll log",
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "required": ["n", "z", "party", "other", "skipped", "nat20", "nat1"],
          "additionalProperties": false,
          "properties": {
            "n": {"$ref": "#/$defs/count"},
            "z": {"type": "number"},
            "party": {"$ref": "#/$defs/count"},
            "other": {"$ref": "#/$defs/count"},
            "skipped": {"$ref": "#/$defs/count"},
            "nat20": {"$ref": "#/$defs/count"},
            "nat1": {"$ref": "#/$defs/count"}
          }
        }
      ]
    },
    "reloads": {"$ref": "#/$defs/count"},
    "deaths": {
      "type": "object",
      "required": ["fights", "downs", "deaths", "wipes"],
      "additionalProperties": false,
      "properties": {
        "fights": {"$ref": "#/$defs/count"},
        "downs": {"$ref": "#/$defs/count"},
        "deaths": {"$ref": "#/$defs/count"},
        "wipes": {"$ref": "#/$defs/count"}
      }
    },
    "fairness": {
      "type": "object",
      "required": ["leak", "check", "blocks"],
      "additionalProperties": false,
      "properties": {
        "leak": {"$ref": "#/$defs/count"},
        "check": {"$ref": "#/$defs/count"},
        "blocks": {"$ref": "#/$defs/count"}
      }
    },
    "score": {
      "description": "a maximise scenario's score (bg3bench.graders.measure): the fact's value at the run's first snapshot (start) and at run_end (end), gain = end - start (the score), its peak; null without a snapshot. Its passed and t_pass_s are null. Optional, added 2026-10-25 (still v1).",
      "type": "object",
      "required": ["fact", "start", "end", "gain", "peak"],
      "additionalProperties": false,
      "properties": {
        "fact": {"type": "string", "minLength": 1},
        "start": {"type": ["number", "null"]},
        "end": {"type": ["number", "null"]},
        "gain": {"type": ["number", "null"]},
        "peak": {"type": ["number", "null"]}
      }
    },
    "pilot": {
      "description": "what a pilot run didn't play of its condition (bg3bench.conditions.session_gaps): such a run is never published. Absent: the run played its condition exactly. Optional, added 2026-10-22 (still v1).",
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "choices": {
      "description": "a choice scenario's picks (bg3bench.choices.grade over the facts' choice events; never right or wrong) and their persona fit by the judge (null: not judged). Optional, added 2026-10-22 (still v1).",
      "type": "object",
      "required": ["picks", "fit"],
      "additionalProperties": false,
      "properties": {
        "picks": {"type": "array", "items": {
          "type": "object",
          "required": ["t", "scene", "options", "picked", "pick", "reason"],
          "additionalProperties": false,
          "properties": {
            "t": {"type": ["number", "null"]},
            "scene": {"type": "string"},
            "options": {"type": "array", "items": {"type": "string"}},
            "picked": {"type": ["integer", "null"]},
            "pick": {"type": "string"},
            "reason": {"type": ["string", "null"]}
          }
        }},
        "fit": {"oneOf": [
          {"type": "null"},
          {"type": "object", "required": ["status", "score", "judge_model"],
           "properties": {
             "status": {"enum": ["ok", "judge_failed", "no_decisions"]},
             "score": {"type": ["number", "null"], "minimum": 0, "maximum": 10},
             "judge_model": {"type": ["string", "null"]},
             "summary": {"type": "string"},
             "cost_usd": {"type": "number", "minimum": 0},
             "call_costs": {"type": "array", "items": {"type": "number", "minimum": 0}},
             "error": {"type": "string"},
             "items": {"type": "array", "items": {"type": "object"}}
           }}
        ]}
      }
    }
  }
}
