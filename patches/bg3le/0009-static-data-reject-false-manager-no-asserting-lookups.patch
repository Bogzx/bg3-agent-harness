+// The manager's type indices and banks, read with fault-tolerant reads and
+// never through bg3se's Array accessors, which assert on a bad index.
+bool read_definitions(void const* manager, std::vector<std::int32_t>* keys,
+                      std::vector<void*>* banks) {
+    auto const* base = (char const*)manager;
+    void* keyBuf = nullptr;
+    std::uint32_t keyCount = 0;
+    void* valueBuf = nullptr;
+    if (!read_as(base + kKeysOffset + kArrayBuffer, &keyBuf)) return false;
+    if (!read_as(base + kKeysOffset + kArraySize, &keyCount)) return false;
+    if (!read_as(base + kValuesOffset + kArrayBuffer, &valueBuf)) return false;
+    if (keyBuf == nullptr || valueBuf == nullptr || keyCount > 400) return false;
+    keys->resize(keyCount);
+    banks->resize(keyCount);
+    return safe_read(keyBuf, keys->data(), keyCount * sizeof(std::int32_t))
+        && safe_read(valueBuf, banks->data(), keyCount * sizeof(void*));
+}
+
