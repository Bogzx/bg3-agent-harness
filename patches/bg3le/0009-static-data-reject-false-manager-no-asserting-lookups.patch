+// Whether a HashMap's bucket heads (HashKeys) and chains (NextIds) are
+// consistent with its Keys: every head and link is -1 or a key index, the
+// chains visit every key exactly once with no cycle, and no key repeats.
+//
+// Keys and Values alone were not enough. Twice (2026-10-10 18:03, claude-run-2
+// S060 2026-10-11 09:11) the scan stopped at a map 0x6f000 bytes before the
+// real one whose Keys and Values passed but whose HashKeys pointed past its
+// Keys, so the first try_get died on bg3se's `index < size_` assertion
+// (SIGILL) inside a debug-port eval. A map the engine can actually look things
+// up in passes this; a stale or half-built copy does not.
+bool hash_chains_hold(char const* base, void const* keyBuf,
+                      std::uint32_t keyCount) {
+    void* headBuf = nullptr;
+    std::uint32_t headCount = 0;
+    void* nextBuf = nullptr;
+    std::uint32_t nextCount = 0;
+    if (!read_as(base + kHashKeysOffset + kArrayBuffer, &headBuf)) return false;
+    if (!read_as(base + kHashKeysOffset + kStaticArraySize, &headCount)) return false;
+    if (!read_as(base + kNextIdsOffset + kArrayBuffer, &nextBuf)) return false;
+    if (!read_as(base + kNextIdsOffset + kArraySize, &nextCount)) return false;
+    if (headBuf == nullptr || nextBuf == nullptr) return false;
+    if (headCount == 0 || headCount > 8192) return false;
+    if (nextCount != keyCount) return false;
+
+    std::vector<std::int32_t> heads(headCount);
+    std::vector<std::int32_t> next(keyCount);
+    std::vector<std::int32_t> keys(keyCount);
+    if (!safe_read(headBuf, heads.data(), headCount * sizeof(std::int32_t))) return false;
+    if (!safe_read(nextBuf, next.data(), keyCount * sizeof(std::int32_t))) return false;
+    if (!safe_read(keyBuf, keys.data(), keyCount * sizeof(std::int32_t))) return false;
+
+    const auto in_range = [&](std::int32_t i) {
+        return i == -1 || (i >= 0 && (std::uint32_t)i < keyCount);
+    };
+    std::vector<bool> seen(keyCount, false);
+    std::uint32_t visited = 0;
+    for (std::int32_t head : heads) {
+        if (!in_range(head)) return false;
+        for (std::int32_t i = head; i >= 0; i = next[(std::uint32_t)i]) {
+            if (seen[(std::uint32_t)i]) return false;  // cycle or shared tail
+            seen[(std::uint32_t)i] = true;
+            ++visited;
+            if (!in_range(next[(std::uint32_t)i])) return false;
+        }
+    }
+    if (visited != keyCount) return false;
+
+    std::vector<std::int32_t> sorted(keys);
+    std::sort(sorted.begin(), sorted.end());
+    return std::adjacent_find(sorted.begin(), sorted.end()) == sorted.end();
+}
