+constexpr std::size_t kInputHooks = sizeof(g_input_hooks) / sizeof(g_input_hooks[0]);
+
+template <std::size_t N>
+std::uint64_t input_hook(void* self, std::uint64_t a, std::uint64_t b, std::uint64_t c) {
+    const bool taken = bg3le_ui_frame_begin();
+    const std::uint64_t result = g_input_hooks[N].Original(self, a, b, c);
+    bg3le_ui_frame_end(taken);
+    return result;
+}
+
+template <std::size_t... N>
+std::size_t hook_input(std::index_sequence<N...>) {
+    void* const replacements[] = {reinterpret_cast<void*>(&input_hook<N>)...};
+    std::size_t hooked = 0;
+    for (std::size_t i = 0; i < kInputHooks; ++i) {
+        if (hook_view_slot(g_input_hooks[i].Function, replacements[i],
+                           &g_input_hooks[i].Original)) {
+            ++hooked;
+        } else {
+            logf("noesis: %s not hooked", g_input_hooks[i].Function);
+        }
+    }
+    return hooked;
+}
