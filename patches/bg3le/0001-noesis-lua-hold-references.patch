+// Drops the references Lua let go of; on the UI thread, from View::Update.
+extern "C" void bg3le_ui_drain_releases()
+{
+    std::vector<Noesis::BaseComponent*> now;
+    {
+        std::lock_guard<std::mutex> held(Noesis::bg3le_ui::g_release_lock);
+        if (Noesis::bg3le_ui::g_releases.empty()) return;
+        now.swap(Noesis::bg3le_ui::g_releases);
+    }
+    for (auto o : now) o->Release();
+}
+
