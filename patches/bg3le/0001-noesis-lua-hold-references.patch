 // ---- objects -------------------------------------------------------------
 
-// A light userdata is only as good as the object behind it; this catches the
-// unmapped case rather than every stale one.
+// A Noesis object crosses into Lua as a full userdata (a Held) that keeps a
+// reference to it until the box is collected, so a proxy Lua still holds
+// cannot outlive its object: the dialogue page frees its answers' view models
+// when it re-templates. One box per object at a time, cached by address in a
+// weak registry table, so a proxy's identity is still its object's.
+struct Held
+{
+    BaseObject* Object;
+    bool Counted;  // a BaseComponent, holding a reference; Types are not counted
+};
+
+char const* const kHeldMeta = "bg3le.NoesisObject";
+char g_held_cache_key = 0;
+
+// The last reference can only go on the UI's own thread: __gc queues it, and
+// the View's Update hook drains the queue (noesis_ui.cpp).
+std::mutex g_release_lock;
+std::vector<BaseComponent*> g_releases;
+
+void release_later(BaseComponent* o)
+{
+    if (!bg3le::noesis_update_hooked()) {
+        o->Release();
+        return;
+    }
+    std::lock_guard<std::mutex> held(g_release_lock);
+    g_releases.push_back(o);
+}
+
+int held_gc(lua_State* L)
+{
+    auto h = static_cast<Held*>(luaL_checkudata(L, 1, kHeldMeta));
+    if (h->Object != nullptr && h->Counted) {
+        release_later(static_cast<BaseComponent*>(h->Object));
+    }
+    h->Object = nullptr;
+    return 0;
+}
+
+// The Noesis address, as a light userdata printed: proxies are told apart by
+// tostring.
+int held_tostring(lua_State* L)
+{
+    auto h = static_cast<Held*>(luaL_checkudata(L, 1, kHeldMeta));
+    lua_pushfstring(L, "userdata: %p", static_cast<void*>(h->Object));
+    return 1;
+}
+
+// One code range: [from, to) as run-time addresses.
+struct CodeRange
+{
+    std::uintptr_t From{ 0 };
+    std::uintptr_t To{ 0 };
+    bool Has(std::uintptr_t at) const { return at >= From && at < To; }
+};
+
+// libbg3le.so's executable segment: the classes RegisterType builds and
+// LuaDelegateCommand have their vtables' functions here.
+CodeRange own_code()
+{
+    CodeRange r;
+    dl_iterate_phdr(
+        [](struct dl_phdr_info* info, std::size_t, void* data) {
+            auto* out = static_cast<CodeRange*>(data);
+            auto self = reinterpret_cast<std::uintptr_t>(&own_code);
+            for (int i = 0; i < info->dlpi_phnum; ++i) {
+                const ElfW(Phdr)& ph = info->dlpi_phdr[i];
+                if (ph.p_type != PT_LOAD || !(ph.p_flags & PF_X)) continue;
+                auto from = info->dlpi_addr + ph.p_vaddr;
+                if (self >= from && self < from + ph.p_memsz) {
+                    *out = CodeRange{ from, from + ph.p_memsz };
+                    return 1;
+                }
+            }
+            return 0;
+        },
+        &r);
+    return r;
+}
+
+CodeRange game_code()
+{
+    CodeRange r;
+    std::uintptr_t offset = 0;
+    std::size_t size = 0;
+    if (bg3le::text_range(&offset, &size)) {
+        r.From = bg3le::load_bias() + offset;
+        r.To = r.From + size;
+    }
+    return r;
+}
+
+// A live object's vtable holds code: its destructors and GetClassType are
+// functions of the game's Noesis or of bg3le. Memory that has been freed and
+// reused reads as anything (the crash this guards against jumped into
+// .data.rel.ro).
+bool plausible_object(BaseObject const* o)
+{
+    static const CodeRange game = game_code();
+    static const CodeRange own = own_code();
+    std::uintptr_t const* vtable = nullptr;
+    std::uintptr_t slots[3] = {};  // ~BaseObject twice (Itanium), GetClassType
+    if (o == nullptr || !bg3le::safe_read(o, &vtable, sizeof(vtable)) || vtable == nullptr
+        || !bg3le::safe_read(vtable, slots, sizeof(slots))) {
+        return false;
+    }
+    if (game.From == 0) return true;  // no ranges to check against
+    for (auto fn : slots) {
+        if (!game.Has(fn) && !own.Has(fn)) return false;
+    }
+    return true;
+}
+
+// A pushed object, or a light userdata from before (still accepted); this
+// catches the unmapped and the reused-as-something-else cases, and the
+// reference a box holds the rest.
 BaseObject* object_arg(lua_State* L, int index)
 {
-    if (!lua_islightuserdata(L, index)) {
+    BaseObject* o = nullptr;
+    if (auto h = static_cast<Held*>(luaL_testudata(L, index, kHeldMeta)); h != nullptr) {
+        o = h->Object;
+    } else if (lua_islightuserdata(L, index)) {
+        o = static_cast<BaseObject*>(lua_touserdata(L, index));
+    } else {
         luaL_argerror(L, index, "expected a Noesis object");
         return nullptr;
     }
-    auto o = static_cast<BaseObject*>(lua_touserdata(L, index));
-    void* vtable = nullptr;
-    if (o == nullptr || !bg3le::safe_read(o, &vtable, sizeof(vtable)) || vtable == nullptr) {
+    if (!plausible_object(o)) {
         luaL_argerror(L, index, "Noesis object is gone");
         return nullptr;
     }
@@ -54,13 +174,51 @@ BaseObject* optional_object(lua_State* L, int index)
     return lua_isnoneornil(L, index) ? nullptr : object_arg(L, index);
 }
 
-void push_object(lua_State* L, void const* o)
+void push_object(lua_State* L, void const* p)
 {
+    auto o = static_cast<BaseObject*>(const_cast<void*>(p));
     if (o == nullptr) {
         lua_pushnil(L);
-    } else {
-        lua_pushlightuserdata(L, const_cast<void*>(o));
+        return;
     }
+    // registry[&key] = setmetatable({}, {__mode = "v"}): address -> box
+    if (lua_rawgetp(L, LUA_REGISTRYINDEX, &g_held_cache_key) != LUA_TTABLE) {
+        lua_pop(L, 1);
+        lua_newtable(L);
+        lua_createtable(L, 0, 1);
+        lua_pushliteral(L, "v");
+        lua_setfield(L, -2, "__mode");
+        lua_setmetatable(L, -2);
+        lua_pushvalue(L, -1);
+        lua_rawsetp(L, LUA_REGISTRYINDEX, &g_held_cache_key);
+    }
+    if (lua_rawgetp(L, -1, o) == LUA_TUSERDATA) {
+        lua_remove(L, -2);
+        return;
+    }
+    lua_pop(L, 1);
+
+    auto h = static_cast<Held*>(lua_newuserdata(L, sizeof(Held)));
+    h->Object = o;
+    h->Counted = false;
+    if (luaL_newmetatable(L, kHeldMeta)) {
+        lua_pushcfunction(L, held_gc);
+        lua_setfield(L, -2, "__gc");
+        lua_pushcfunction(L, held_tostring);
+        lua_setfield(L, -2, "__tostring");
+        lua_pushliteral(L, "NoesisObject");
+        lua_setfield(L, -2, "__metatable");
+    }
+    lua_setmetatable(L, -2);
+    // Taken after the metatable is set, so a failed allocation above leaks
+    // nothing; refcounted objects are the BaseComponents.
+    if (TypeHelpers::IsDescendantOf(o->GetClassType(), TypeOf<BaseComponent>())) {
+        static_cast<BaseComponent*>(o)->AddReference();
+        h->Counted = true;
+    }
+    lua_pushvalue(L, -1);
+    lua_rawsetp(L, -3, o);
+    lua_remove(L, -2);
 }
 
 bool is_a(BaseObject const* o, TypeClass const* cls)
@@ -977,6 +1135,8 @@ int l_instantiate(lua_State* L)
     auto inst = (*cls)->Construct(wrapped);
     if (!inst) return luaL_error(L, "Unable to construct data context '%s' - invalid parameters", name.c_str());
     push_object(L, static_cast<BaseComponent*>(inst));
+    // The box's reference is now the one Construct made.
+    static_cast<BaseComponent*>(inst)->Release();
     return 1;
