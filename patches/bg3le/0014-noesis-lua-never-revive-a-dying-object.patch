+
+// The references object_arg took for the C calls running on this thread; each
+// serialized() gives its own back when its call ends, error or not.
+thread_local std::vector<PendingRelease> t_call_refs;
+
+// One reference back. Lua's thread never makes the last Release: that one goes
+// the way a box's does, to the UI thread.
+void drop_call_ref(PendingRelease const& r)
+{
+    int32_t* refs = ref_count(r.Object);
+    int32_t n = __atomic_load_n(refs, __ATOMIC_ACQUIRE);
+    while (n > 1) {
+        if (__atomic_compare_exchange_n(refs, &n, n - 1, true, __ATOMIC_ACQ_REL, __ATOMIC_ACQUIRE)) {
+            return;
+        }
+    }
+    release_later(r.Object, r.Generation, r.ViewGeneration);
+}
+
+struct CallRefs
+{
+    std::size_t Mark = t_call_refs.size();
+    ~CallRefs()
+    {
+        while (t_call_refs.size() > Mark) {
+            const PendingRelease r = t_call_refs.back();
+            t_call_refs.pop_back();
+            drop_call_ref(r);
+        }
+    }
+};
