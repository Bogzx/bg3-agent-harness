+// BaseRefCounted's count, an int32 after the vtable: the game's Release is
+// `lock xadd %eax,0x8(%rdi)`, and patch 0008 reads the same word.
+constexpr std::size_t kRefCountOffset = 8;
+
+int32_t* ref_count(BaseObject* o)
+{
+    return reinterpret_cast<int32_t*>(reinterpret_cast<char*>(o) + kRefCountOffset);
+}
+
+// A reference, only if the object still has one. At a count of 0 its OnDestroy
+// is running (DependencyObject's runs the Destroyed handlers at 0, then the
+// destructor): AddReference would count up an object that goes on to be freed
+// whatever the count says, and leave a box pinning a free block. Call after
+// plausible_object. The CAS itself writes to the object: if the block is freed
+// and reused between that check and here, the word can be someone else's. That
+// window is far smaller than the one this closes, but it is not nothing.
+bool try_add_reference(BaseObject* o)
+{
+    int32_t* refs = ref_count(o);
+    int32_t n = __atomic_load_n(refs, __ATOMIC_ACQUIRE);
+    while (n > 0) {
+        if (__atomic_compare_exchange_n(refs, &n, n + 1, true, __ATOMIC_ACQ_REL, __ATOMIC_ACQUIRE)) {
+            return true;
+        }
+    }
+    return false;
+}
+
+// Dying objects Ext.UI refused, logged as bad_value is: try() in the mod hides
+// the error, and the log is what shows this path ran.
+std::atomic<unsigned long long> g_dying_refused{ 0 };
+
+void dying_object(char const* where, void const* o)
+{
+    auto n = g_dying_refused.fetch_add(1, std::memory_order_relaxed);
+    if (n < 20 || (n & (n - 1)) == 0) {
+        bg3le::logf("Ext.UI: %s: Noesis object %p is dying, count 0; refused (%llu so far)", where, o, n + 1);
+    }
