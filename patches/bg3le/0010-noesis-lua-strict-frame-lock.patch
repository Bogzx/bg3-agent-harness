bg3le Ext.UI: strict mode for the frame lock (off by default); log lock timeouts

On top of 0001-0009 (audit 2026-10-13 UI-5). 0002/0003's frame lock is given up on a timeout by both
sides: Lua after 50 ms runs the call unserialized, the UI thread after 16 ms runs the frame unguarded, so
under load (907 ms-6.6 s Tick stalls) the raw-child-pointer -> AddReference window 0001 leaves is open
again, and nothing but UiSerialize's counters said so.

- Strict mode, BG3LE_UI_STRICT=1 in the environment or Ext._Internal.UiStrict(true) at run time: a Lua
  call that cannot take the lock in 50 ms fails with a Lua error "bg3le: UI busy (frame lock not taken in
  50 ms); retry" instead of running; callers (the mod's UI.try) see nil and retry on a later tick. The UI
  thread waits up to 100 ms (16 ms otherwise) before running a frame unguarded; still bounded, since Lua
  can be inside a game function waiting on a lock the UI thread holds.
- Ext._Internal.UiStrict([on]) -> on, calls refused.
- Both timeouts are logged at counts 1, 2, 4, 8, ...: "noesis: Lua frame-lock timeout #N (50 ms); ran
  unserialized|strict: refused", "noesis: UI-thread frame-lock timeout #N (16|100 ms): frame ran unguarded".
Off by default: needs a live run under load (refusal rate, frame pacing) before it becomes the default.
---
diff --git a/src/vendor/bg3le_noesis_lua.inl b/src/vendor/bg3le_noesis_lua.inl
--- a/src/vendor/bg3le_noesis_lua.inl
+++ b/src/vendor/bg3le_noesis_lua.inl
@@ -396,6 +396,21 @@
 constexpr int kFrameWaitMs = 50;
 constexpr int kUiWaitMs = 16;
 
+// Strict mode (off by default; BG3LE_UI_STRICT=1 or Ext._Internal.UiStrict(true)): a Lua call that cannot
+// take the frame lock in kFrameWaitMs fails with a Lua error ("UI busy") instead of running unserialized, so
+// the window between reading a raw child pointer and AddReference stays closed under load (907 ms-6.6 s Tick
+// stalls); the caller retries on a later tick. The UI thread waits kUiStrictWaitMs before running a frame
+// unguarded (still bounded: Lua can be inside a game function waiting on a lock the UI thread holds).
+std::atomic<bool> g_strict{ false };
+std::atomic<unsigned long long> g_strict_refusals{ 0 };
+constexpr int kUiStrictWaitMs = 100;
+
+// Timeouts are logged at 1, 2, 4, 8, ... so a run of them shows in the log without flooding it.
+bool log_this_count(unsigned long long n)
+{
+    return n != 0 && (n & (n - 1)) == 0;
+}
+
 // Whether the call running on this thread holds g_frame (or serializing is
 // off): UiProperties enumerates a DependencyObject's values only then.
 thread_local bool t_framed = false;
@@ -414,7 +429,15 @@
     }
     std::unique_lock<std::recursive_timed_mutex> held(g_frame, std::defer_lock);
     if (!held.try_lock_for(std::chrono::milliseconds(kFrameWaitMs))) {
-        g_serialize_timeouts.fetch_add(1, std::memory_order_relaxed);
+        const auto n = g_serialize_timeouts.fetch_add(1, std::memory_order_relaxed) + 1;
+        const bool strict = g_strict.load(std::memory_order_relaxed);
+        if (log_this_count(n))
+            bg3le::logf("noesis: Lua frame-lock timeout #%llu (%d ms)%s", n, kFrameWaitMs,
+                        strict ? "; strict: refused" : "; ran unserialized");
+        if (strict) {
+            g_strict_refusals.fetch_add(1, std::memory_order_relaxed);
+            return luaL_error(L, "bg3le: UI busy (frame lock not taken in %d ms); retry", kFrameWaitMs);
+        }
     }
     t_framed = held.owns_lock();
     // Lua is built as C++: a Lua error unwinds through here and unlocks.
@@ -439,6 +462,15 @@
     return 8;
 }
 
+// UiStrict([on]) -> on, Lua calls refused for a lock timeout
+int l_strict(lua_State* L)
+{
+    if (!lua_isnoneornil(L, 1)) g_strict.store(lua_toboolean(L, 1) != 0);
+    lua_pushboolean(L, g_strict.load() ? 1 : 0);
+    lua_pushinteger(L, (lua_Integer)g_strict_refusals.load());
+    return 2;
+}
+
 // ---- values: ports of StoredValueHelpers ---------------------------------
 
 void push_floats(lua_State* L, float const* v, int n)
@@ -1576,8 +1608,12 @@
 {
     using namespace Noesis::bg3le_ui;
     if (!g_serialize.load(std::memory_order_relaxed)) return false;
-    if (g_frame.try_lock_for(std::chrono::milliseconds(kUiWaitMs))) return true;
-    g_ui_timeouts.fetch_add(1, std::memory_order_relaxed);
+    const bool strict = g_strict.load(std::memory_order_relaxed);
+    if (g_frame.try_lock_for(std::chrono::milliseconds(strict ? kUiStrictWaitMs : kUiWaitMs))) return true;
+    const auto n = g_ui_timeouts.fetch_add(1, std::memory_order_relaxed) + 1;
+    if (log_this_count(n))
+        bg3le::logf("noesis: UI-thread frame-lock timeout #%llu (%d ms): frame ran unguarded", n,
+                    strict ? kUiStrictWaitMs : kUiWaitMs);
     return false;
 }
 
@@ -1737,9 +1773,13 @@
     }
     lua_pushcfunction(L, Noesis::bg3le_ui::l_serialize);
     lua_setfield(L, -2, "UiSerialize");
+    lua_pushcfunction(L, Noesis::bg3le_ui::l_strict);
+    lua_setfield(L, -2, "UiStrict");
     static bool from_env = [] {
         char const* v = std::getenv("BG3LE_UI_SERIALIZE");
         if (v != nullptr && v[0] != '\0') Noesis::bg3le_ui::g_serialize.store(v[0] != '0');
+        char const* s = std::getenv("BG3LE_UI_STRICT");
+        if (s != nullptr && s[0] != '\0') Noesis::bg3le_ui::g_strict.store(s[0] != '0');
         return true;
     }();
     (void)from_env;
