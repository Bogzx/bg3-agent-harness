+bool plausible_object(BaseObject const* o)
+{
+    return plausible_vtable(o);
+}
+
+// Property values that were not objects where an object was due, pushed as
+// nil instead (UiSerialize's 8th result). S017's crash: a DependencyObject's
+// stored value read 0x100 where its property's type said BaseObject, and
+// push_boxed_or_object called GetClassType through it.
+std::atomic<unsigned long long> g_bad_values{ 0 };
+
+void bad_value(char const* where, Symbol const* name, void const* value)
+{
+    auto n = g_bad_values.fetch_add(1, std::memory_order_relaxed);
+    if (n < 20 || (n & (n - 1)) == 0) {  // the first 20, then at powers of two
+        ERR("Ext.UI: %s: property %s holds no live object (%p); read as nil (%llu so far)", where,
+            name != nullptr ? name->Str() : "?", value, n + 1);
+    }
+}
+
 // A pushed object, or a light userdata from before (still accepted); this
 // catches the unmapped and the reused-as-something-else cases, and the
 // reference a box holds the rest.
@@ -375,21 +396,35 @@ std::atomic<unsigned long long> g_ui_timeouts{ 0 };
 constexpr int kFrameWaitMs = 50;
 constexpr int kUiWaitMs = 16;
 
+// Whether the call running on this thread holds g_frame (or serializing is
+// off): UiProperties enumerates a DependencyObject's values only then.
+thread_local bool t_framed = false;
+
 int serialized(lua_State* L)
 {
     auto fn = lua_tocfunction(L, lua_upvalueindex(1));
-    if (!g_serialize.load(std::memory_order_relaxed)) return fn(L);
+    struct Framed
+    {
+        bool Was = t_framed;
+        ~Framed() { t_framed = Was; }
+    } restore;
+    if (!g_serialize.load(std::memory_order_relaxed)) {
+        t_framed = true;
+        return fn(L);
+    }
     std::unique_lock<std::recursive_timed_mutex> held(g_frame, std::defer_lock);
     if (!held.try_lock_for(std::chrono::milliseconds(kFrameWaitMs))) {
         g_serialize_timeouts.fetch_add(1, std::memory_order_relaxed);
     }
+    t_framed = held.owns_lock();
     // Lua is built as C++: a Lua error unwinds through here and unlocks.
     return fn(L);
 }
 
