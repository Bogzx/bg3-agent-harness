+    alignas(StoredValue) unsigned char vbuf[sizeof(StoredValue)];
+    auto const& v = *reinterpret_cast<StoredValue const*>(vbuf);
+    if (o == nullptr || !bg3le::safe_read(o, vbuf, sizeof(vbuf))) {
+        bad_value("push_stored", name, o);
