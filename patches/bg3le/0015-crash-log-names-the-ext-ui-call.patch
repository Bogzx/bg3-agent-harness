+// From the crash handler (stackdump.cpp): names the Ext.UI calls running on this
+// thread, innermost first, before anything that can fault. Reads what may be gone
+// through safe_read: the notes sit on a stack a bad call can have trashed, and the
+// object is the likely suspect.
+extern "C" void bg3le_ui_log_crash_call()
+{
+    using namespace Noesis::bg3le_ui;
+    CallNote const* at = t_call_note;
+    if (at == nullptr) {
+        bg3le::logf("crash: no Ext.UI call on this thread");
+        return;
+    }
+    for (int depth = 0; at != nullptr && depth < 4; ++depth) {
+        CallNote note;
+        if (!bg3le::safe_read(at, &note, sizeof(note))) {
+            bg3le::logf("crash: Ext.UI call %d: note at %p unreadable", depth, static_cast<void const*>(at));
+            return;
+        }
+        note.Key[sizeof(note.Key) - 1] = '\0';
+        Dl_info dl{};
+        const bool named = ::dladdr(reinterpret_cast<void*>(note.Fn), &dl) != 0 && dl.dli_sname != nullptr;
+        char cls[96] = "";
+        if (note.ClassName == nullptr || !bg3le::safe_cstr(note.ClassName, cls, sizeof(cls))) std::strcpy(cls, "?");
+        bg3le::logf("crash: Ext.UI call %d: %s key '%s' object %p class '%s' boxed %d counted %d", depth,
+                    named ? dl.dli_sname : "?", note.Key, static_cast<void const*>(note.Object), cls, note.Boxed ? 1 : 0,
+                    note.Counted ? 1 : 0);
+        std::uintptr_t word = 0;
+        std::int32_t refs = 0;
+        if (note.Object != nullptr && bg3le::safe_read(note.Object, &word, sizeof(word))
+            && bg3le::safe_read(reinterpret_cast<char const*>(note.Object) + kRefCountOffset, &refs, sizeof(refs))) {
+            bg3le::logf("crash:   its first word %#lx, word at +8 %d", static_cast<unsigned long>(word), refs);
+        }
+        at = note.Outer;
+    }
+}
