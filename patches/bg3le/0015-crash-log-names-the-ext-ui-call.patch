+// What the Ext.UI call running on this thread is working on, for the crash
+// log: the C function, its string argument (a property name, usually) and the
+// first object it took. Lives on serialized()'s stack, so a nested call keeps
+// the outer one's.
+struct CallNote
+{
+    lua_CFunction Fn;
+    BaseObject const* Object;
+    char const* ClassName;
+    bool Boxed;
+    bool Counted;
+    char Key[64];
+    CallNote const* Outer;
+};
+thread_local CallNote* t_call_note = nullptr;
+
+struct CallScope
+{
+    CallNote Note{};
+    CallScope(lua_State* L, lua_CFunction fn)
+    {
+        Note.Fn = fn;
+        Note.Outer = t_call_note;
+        if (lua_type(L, 2) == LUA_TSTRING) std::strncpy(Note.Key, lua_tostring(L, 2), sizeof(Note.Key) - 1);
+        t_call_note = &Note;
+    }
+    ~CallScope() { t_call_note = const_cast<CallNote*>(Note.Outer); }
+};
