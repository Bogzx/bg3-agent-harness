 extern "C" void bg3le_ui_drain_releases()
 {
-    std::vector<Noesis::bg3le_ui::PendingRelease> now;
+    using namespace Noesis::bg3le_ui;
+    static unsigned settled_generation = 0;
+    static std::chrono::steady_clock::time_point settled_from;
+
+    std::vector<PendingRelease> now;
     {
-        std::lock_guard<std::mutex> held(Noesis::bg3le_ui::g_release_lock);
-        if (Noesis::bg3le_ui::g_releases.empty()) return;
