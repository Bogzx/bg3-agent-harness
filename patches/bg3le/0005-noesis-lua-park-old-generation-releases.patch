-    for (auto const& r : now) Noesis::bg3le_ui::release_now(r);
+    const unsigned generation = g_generation.load();
+    const unsigned view = g_view_generation.load();
+    const bool settled = ui_settled();
+    for (auto const& r : now) {
+        if (r.ViewGeneration != view) {
+            leak(r);
+        } else if (r.Generation == generation && settled) {
+            release_checked(r);
+        } else if (park_enabled()) {
+            g_parked.push_back(r);
+        } else {
