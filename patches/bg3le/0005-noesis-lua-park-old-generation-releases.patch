+    }
+    if (g_parked.empty()) {
+        g_parked_count.store(0);
+        return;
+    }
+
+    const auto clock = std::chrono::steady_clock::now();
+    if (!settled) {
+        settled_generation = 0;
+    } else if (settled_generation != generation) {
+        settled_generation = generation;
+        settled_from = clock;
+    }
+    const bool ready = settled && settled_generation == generation
+        && clock - settled_from >= std::chrono::milliseconds(kParkSettleMs);
+    std::size_t given = 0;
+    std::size_t kept = 0;
+    for (std::size_t i = 0; i < g_parked.size(); ++i) {
+        auto const& r = g_parked[i];
+        if (r.ViewGeneration != view) {
+            leak(r);
+        } else if (ready && given < kParkedPerFrame) {
+            release_checked(r);
+            g_released_late.fetch_add(1, std::memory_order_relaxed);
+            ++given;
+        } else {
